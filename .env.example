# SpringInsight environment configuration
# ─────────────────────────────────────────
# Copy this file to .env in your working directory (where you run
# `springinsight init` and `springinsight run`) and fill in the values.
#
# The .env file is NEVER committed to version control — it is already
# listed in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────
# Your Anthropic API key. Obtain one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ──────────────────────────────────────────────────────────────────

# Override the default data directory for the Web UI
# Default: ~/.springinsight/web
# SPRINGINSIGHT_DATA_DIR=/var/data/springinsight

# Set a custom log level (DEBUG, INFO, WARNING, ERROR)
# Default: WARNING
# LOG_LEVEL=INFO

# Proxy settings (if your network requires them)
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1
